__pycache__/
*.pyc
.DS_Store

# local dogfood config: pins an output style and points at machine-local
# paths, so cloning it would silently apply the style to someone else's repo
.claude/

# local experiment captures, not for publishing
benchmark/local/

# benchmark result JSONs are regenerable; digested numbers live in the README
benchmark/*results*.json
benchmark/drift_*.json
benchmark/ab_*.json
benchmark/glance_*.json
benchmark/position_results_*.json
benchmark/paired_*.json

# hook firing log (working file, if ever written to a project dir)
hook_fired.log
